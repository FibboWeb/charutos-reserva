{%- style -%}
  .airkool-rich-container {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .airkool-rich-container .banner-img {
    position: relative;
    display: flex;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }
  .banner-img img { object-fit: contain; width: 100%; display: block; }
  .airkool-rich-container .banner-img svg.placeholder_svg { height: 300px; }
  .banner-img__link { display: block; width: 100%; line-height: 0; }
  .banner-img__link:hover img { opacity: 0.92; transition: opacity var(--duration-default) ease; }

  /* ── Overlay escuro via ::after ── */
  {% if section.settings.overlay_opacity > 0 %}
  .airkool-rich-container .banner-img::after {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba({{ section.settings.overlay_color.red }},{{ section.settings.overlay_color.green }},{{ section.settings.overlay_color.blue }},{{ section.settings.overlay_opacity | times: 0.01 }});
    pointer-events: none;
    z-index: 1;
  }
  {% endif %}

  /* ── Text overlay ── */
  .dt-rich-overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    display: flex;
    align-items: center;
    pointer-events: none;
    z-index: 2;
  }
  .dt-rich-overlay__inner {
    width: 50%;
    max-width: 50%;
    padding: 2rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    pointer-events: auto;
  }
  .dt-rich-overlay__kicker {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #C49A3C;
    margin: 0;
  }
  .dt-rich-overlay__heading {
    font-size: clamp(2rem, 3vw, 4rem);
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0;
    line-height: 1.15;
  }
  .dt-rich-overlay__desc {
    color: #fff;
    font-size: 1.4rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
  }
  .dt-rich-overlay__btn {
    align-self: flex-start;
    margin-top: 0.5rem;
    background: #C49A3C !important;
    color: #fff !important;
    border-color: #C49A3C !important;
  }
  .dt-rich-overlay__btn:hover {
    background: #a8832f !important;
    border-color: #a8832f !important;
    color: #fff !important;
  }

  @media screen and (max-width: 1200px) {
    .airkool-rich-container { padding-top: 0; }
  }
  @media screen and (max-width: 750px) {
    .dt-rich-overlay__inner {
      width: 100%;
      max-width: 100%;
      padding: 1.5rem;
    }
    .dt-rich-overlay__desc { white-space: normal; }
  }
{%- endstyle -%}

<div class="{% if section.settings.page_full_width %} page-full-width {% else %} page-width {% endif %} {% if section.settings.page_full_width_spacing %} page-full-width_spacing {% endif %}airkool-rich-container">
  <div class="banner-img">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="banner-img__link"{% if section.settings.link_title != blank %} aria-label="{{ section.settings.link_title | escape }}"{% endif %}>
    {%- endif -%}
    {%- if section.settings.bg-image != blank -%}
      <img src="{{ section.settings.bg-image | image_url: width: 1920, height: 300 }}" alt="{{ section.settings.link_title | default: section.settings.bg-image.alt | escape }}">
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder_svg' }}
    {%- endif -%}
    {%- if section.settings.link != blank -%}
      </a>
    {%- endif -%}

    {%- if section.settings.kicker != blank or section.settings.heading != blank or section.settings.description != blank or section.settings.button_label != blank -%}
      <div class="dt-rich-overlay">
        <div class="dt-rich-overlay__inner">
          {%- if section.settings.kicker != blank -%}
            <p class="dt-rich-overlay__kicker">{{ section.settings.kicker | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="dt-rich-overlay__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <p class="dt-rich-overlay__desc">{{ section.settings.description | escape }}</p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %} class="dt-rich-overlay__btn button">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "rich-text",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "page_full_width",
      "default": false,
      "label": "t:sections.all.page_full_width.label"
    },
    {
      "type": "checkbox",
      "id": "page_full_width_spacing",
      "default": false,
      "label": "t:sections.all.page_full_width_spacing.label"
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Imagem do banner"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link do banner",
      "info": "URL de destino quando o banner for clicado"
    },
    {
      "type": "text",
      "id": "link_title",
      "label": "Título do link (acessibilidade)"
    },
    {
      "type": "header",
      "content": "Filtro sobre a imagem"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Cor do filtro",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Opacidade do filtro",
      "default": 30
    },
    {
      "type": "header",
      "content": "Texto sobre o banner"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow (ex: MELHOR QUALIDADE)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Cor do título",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Descrição (uma linha)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 35
    }
  ],
  "presets": [
    {
      "name": "rich-text"
    }
  ]
}
{% endschema %}
