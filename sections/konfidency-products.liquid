<div class="page-width isolate section-{{ section.id }}-padding">
  {% render 'konfidency-product-reviews', product: product %}
</div>

{% schema %}
{
  "name": "Avaliações Konfidency",
  "tag": "section",
  "class": "section-konfidency-reviews",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "templates": ["product"]
}
{% endschema %}
