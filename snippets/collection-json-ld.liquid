{%- comment -%}
  JSON-LD: CollectionPage + ItemList (página atual) + BreadcrumbList.
  Renderizar dentro de {% paginate collection.products %} para refletir a página paginada.
{%- endcomment -%}
{%- if template.name == 'collection' and collection -%}
  {%- liquid
    assign coll_desc = collection.description | strip_html | strip | truncate: 320
    if coll_desc == blank
      assign coll_desc = collection.title
    endif
    assign pos = 0
    assign json_items = ''
  -%}
  {%- for product in collection.products -%}
    {%- if product.available -%}
      {%- assign pos = pos | plus: 1 -%}
      {%- if json_items != '' -%},{%- endif -%}
      {%- capture piece -%}{"@type":"ListItem","position":{{ pos }},"name":{{ product.title | json }},"url":{{ request.origin | append: product.url | json }}}{%- endcapture -%}
      {%- assign json_items = json_items | append: piece -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for product in collection.products -%}
    {%- unless product.available -%}
      {%- assign pos = pos | plus: 1 -%}
      {%- if json_items != '' -%},{%- endif -%}
      {%- capture piece -%}{"@type":"ListItem","position":{{ pos }},"name":{{ product.title | json }},"url":{{ request.origin | append: product.url | json }}}{%- endcapture -%}
      {%- assign json_items = json_items | append: piece -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- liquid
    assign bc_last_name = collection.title
    if current_tags
      assign tag_label = current_tags | join: ', '
      assign bc_last_name = collection.title | append: ' — ' | append: tag_label
    endif
    assign collection_abs_url = request.origin | append: collection.url
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "@id": {{ canonical_url | append: '#webpage' | json }},
        "url": {{ canonical_url | json }},
        "name": {{ collection.title | json }},
        "description": {{ coll_desc | json }},
        "isPartOf": {
          "@type": "WebSite",
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }}
        },
        "mainEntity": { "@id": {{ canonical_url | append: '#itemlist' | json }} }
      },
      {
        "@type": "ItemList",
        "@id": {{ canonical_url | append: '#itemlist' | json }},
        "numberOfItems": {{ collection.products.size }},
        "itemListElement": [{{ json_items }}]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": {{ 'general.breadcrumbs.home' | t | json }},
            "item": {{ shop.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ 'general.breadcrumbs.all_collections' | t | json }},
            "item": {{ shop.url | append: '/collections' | json }}
          }{% if current_tags %},
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ collection.title | json }},
            "item": {{ collection_abs_url | json }}
          },
          {
            "@type": "ListItem",
            "position": 4,
            "name": {{ bc_last_name | json }},
            "item": {{ canonical_url | json }}
          }{% else %},
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ collection.title | json }},
            "item": {{ canonical_url | json }}
          }{% endif %}
        ]
      }
    ]
  }
  </script>
{%- endif -%}
