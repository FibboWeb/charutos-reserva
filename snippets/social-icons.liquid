                      {%- render 'icon-tumblr' -%}
                      <span class="icon-text visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                    </a>
                  </li>
                  {%- endif -%}
                  {%- if settings.social_snapchat_link != blank -%}
                  <li class="list-social__item">
