{%- comment -%}
  Google Tag Manager + Google Analytics 4
  IDs configuráveis em: Configurações do tema > Analytics & Marketing
{%- endcomment -%}

{%- if settings.gtm_id != blank -%}
  {%- comment -%} Google Tag Manager {%- endcomment -%}
  <script>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','{{ settings.gtm_id }}');
  </script>
{%- endif -%}

{%- if settings.ga4_id != blank -%}
  {%- comment -%} Google Analytics 4 (gtag.js) {%- endcomment -%}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.ga4_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ settings.ga4_id }}');
  </script>
{%- endif -%}
