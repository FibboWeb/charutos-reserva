{%- comment -%}
  Flag de desconto sobre a imagem do card (canto superior esquerdo).
  @param card_product {Object}
{%- endcomment -%}
{%- if card_product.compare_at_price > card_product.price and card_product.available -%}
  {%- assign discount_pct = card_product.compare_at_price
    | minus: card_product.price
    | times: 100.0
    | divided_by: card_product.compare_at_price
    | round
  -%}
  <span class="card__discount-flag" aria-hidden="true">
    {{- 'products.product.discount_flag' | t: percent: discount_pct -}}
  </span>
{%- endif -%}
