{%- liquid
  assign nav_group_count = 0
  for block in section.blocks
    if block.type == 'nav_group'
      assign nav_group_count = nav_group_count | plus: 1
    endif
  endfor
  assign use_nav_groups = false
  if nav_group_count > 0
    assign use_nav_groups = true
  endif
-%}

<nav class="cr-main-nav" id="cr-main-nav" aria-label="Menu principal">
  <div class="cr-main-nav__inner">

    <ul class="cr-main-nav__list" id="cr-main-nav-list">

      {%- if use_nav_groups -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_group' -%}
            {%- assign sub = block.settings.submenu -%}
            {%- assign has_sub = false -%}
            {%- if sub != blank and sub.links.size > 0 -%}
              {%- assign has_sub = true -%}
            {%- endif -%}

            <li class="cr-main-nav__item{% if has_sub %} cr-main-nav__item--has-panel{% endif %}" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.url | default: '#' }}"
                 class="cr-main-nav__link"
                 {% if has_sub %}aria-haspopup="true" aria-expanded="false"{% endif %}>
                <span class="cr-main-nav__icon">
                  {%- if block.settings.icon_image != blank -%}
                    {%- assign _icon_url = block.settings.icon_image | image_url: width: 32 -%}
                    <div class="cr-main-nav__icon-img"
                      role="img"
                      aria-label="{{ block.settings.label | escape }}"
                      style="mask-image:url('{{ _icon_url }}');-webkit-mask-image:url('{{ _icon_url }}')">
                    </div>
                  {%- else -%}
                    {%- render 'icon-nav-category', icon_key: block.settings.icon -%}
                  {%- endif -%}
                </span>
                <span class="cr-main-nav__label">{{ block.settings.label }}</span>
                {%- if has_sub -%}
                  <svg class="cr-main-nav__chevron" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M1 1l4 4 4-4"/>
                  </svg>
                {%- endif -%}
              </a>

              {%- if has_sub -%}
                {%- liquid
                  assign panel_has_third = false
                  for link in sub.links
                    if link.links.size > 0
                      assign panel_has_third = true
                      break
                    endif
                  endfor
                  assign use_mega = false
                  if block.settings.mega_menu and panel_has_third
                    assign use_mega = true
                  endif
                  assign panel_columns = block.settings.columns | default: 2
                -%}
                <div class="cr-main-nav__panel{% if use_mega %} cr-main-nav__panel--mega{% elsif panel_has_third %} cr-main-nav__panel--columns{% endif %}" role="region">
                  <div class="cr-main-nav__panel-inner">
                    {%- if use_mega -%}
                      <div class="cr-main-nav__mega" style="--cr-nav-columns: {{ panel_columns }}">
                        <ul class="cr-main-nav__mega-sidebar" role="menu">
                          {%- for link in sub.links -%}
                            {%- assign link_has_children = false -%}
                            {%- if link.links.size > 0 -%}{%- assign link_has_children = true -%}{%- endif -%}
                            <li class="cr-main-nav__mega-item{% if link_has_children %} cr-main-nav__mega-item--has-children{% endif %}{% if forloop.first %} cr-main-nav__mega-item--all{% endif %}"
                                role="none"
                                data-mega-panel="cr-mega-{{ block.id }}-{{ forloop.index }}">
                              <a href="{{ link.url }}"
                                 class="cr-main-nav__mega-link{% if forloop.first %} cr-main-nav__mega-link--all{% endif %}"
                                 role="menuitem"
                                 {% if link_has_children %}aria-haspopup="true"{% endif %}>
                                {{ link.title }}
                                {%- if link_has_children -%}
                                  <svg class="cr-main-nav__mega-arrow" viewBox="0 0 6 10" fill="none" aria-hidden="true">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M1 1l4 4-4 4"/>
                                  </svg>
                                {%- endif -%}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                        <div class="cr-main-nav__mega-content">
                          {%- assign first_mega_panel = true -%}
                          {%- for link in sub.links -%}
                            {%- if link.links.size > 0 -%}
                              <div class="cr-main-nav__mega-subpanel"
                                   id="cr-mega-{{ block.id }}-{{ forloop.index }}"
                                   role="menu"
                                   {% unless first_mega_panel %}hidden{% endunless %}>
                                <ul class="cr-main-nav__mega-sublist">
                                  {%- for child in link.links -%}
                                    <li role="none">
                                      <a href="{{ child.url }}" class="cr-main-nav__mega-sublink" role="menuitem">{{ child.title }}</a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </div>
                              {%- assign first_mega_panel = false -%}
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- elsif panel_has_third -%}
                      <ul class="cr-main-nav__panel-columns" style="--cr-nav-columns: {{ panel_columns }}">
                        {%- for link in sub.links -%}
                          <li class="cr-main-nav__panel-column{% if forloop.first %} cr-main-nav__panel-column--all{% endif %}">
                            <a href="{{ link.url }}" class="cr-main-nav__panel-heading{% if forloop.first %} cr-main-nav__panel-heading--all{% endif %}">{{ link.title }}</a>
                            {%- if link.links.size > 0 -%}
                              <ul class="cr-main-nav__panel-sublist">
                                {%- for child in link.links -%}
                                  <li>
                                    <a href="{{ child.url }}" class="cr-main-nav__panel-sublink">{{ child.title }}</a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- else -%}
                      <ul class="cr-main-nav__panel-links">
                        {%- for link in sub.links -%}
                          <li{% if forloop.first %} class="cr-main-nav__panel-item--all"{% endif %}>
                            <a href="{{ link.url }}" class="cr-main-nav__panel-link{% if forloop.first %} cr-main-nav__panel-link--all{% endif %}">{{ link.title }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}

      {%- elsif menu != blank and menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          {%- assign has_sub = false -%}
          {%- if link.links.size > 0 -%}{%- assign has_sub = true -%}{%- endif -%}
          <li class="cr-main-nav__item{% if has_sub %} cr-main-nav__item--has-panel{% endif %}">
            <a href="{{ link.url }}" class="cr-main-nav__link">
              <span class="cr-main-nav__icon">
                {%- render 'icon-nav-category', icon_key: link.handle -%}
              </span>
              <span class="cr-main-nav__label">{{ link.title }}</span>
              {%- if has_sub -%}
                <svg class="cr-main-nav__chevron" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M1 1l4 4 4-4"/>
                </svg>
              {%- endif -%}
            </a>
            {%- if has_sub -%}
              {%- liquid
                assign panel_has_third = false
                for child in link.links
                  if child.links.size > 0
                    assign panel_has_third = true
                    break
                  endif
                endfor
              -%}
              <div class="cr-main-nav__panel{% if panel_has_third %} cr-main-nav__panel--mega{% endif %}" role="region">
                <div class="cr-main-nav__panel-inner">
                  {%- if panel_has_third -%}
                    <div class="cr-main-nav__mega" style="--cr-nav-columns: 2">
                      <ul class="cr-main-nav__mega-sidebar" role="menu">
                        {%- for child in link.links -%}
                          {%- assign child_has_children = false -%}
                          {%- if child.links.size > 0 -%}{%- assign child_has_children = true -%}{%- endif -%}
                          <li class="cr-main-nav__mega-item{% if child_has_children %} cr-main-nav__mega-item--has-children{% endif %}{% if forloop.first %} cr-main-nav__mega-item--all{% endif %}"
                              role="none"
                              data-mega-panel="cr-mega-fallback-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                            <a href="{{ child.url }}"
                               class="cr-main-nav__mega-link{% if forloop.first %} cr-main-nav__mega-link--all{% endif %}"
                               role="menuitem"
                               {% if child_has_children %}aria-haspopup="true"{% endif %}>
                              {{ child.title }}
                              {%- if child_has_children -%}
                                <svg class="cr-main-nav__mega-arrow" viewBox="0 0 6 10" fill="none" aria-hidden="true">
                                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M1 1l4 4-4 4"/>
                                </svg>
                              {%- endif -%}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                      <div class="cr-main-nav__mega-content">
                        {%- assign first_mega_panel = true -%}
                        {%- for child in link.links -%}
                          {%- if child.links.size > 0 -%}
                            <div class="cr-main-nav__mega-subpanel"
                                 id="cr-mega-fallback-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                                 role="menu"
                                 {% unless first_mega_panel %}hidden{% endunless %}>
                              <ul class="cr-main-nav__mega-sublist">
                                {%- for grandchild in child.links -%}
                                  <li role="none">
                                    <a href="{{ grandchild.url }}" class="cr-main-nav__mega-sublink" role="menuitem">{{ grandchild.title }}</a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                            {%- assign first_mega_panel = false -%}
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- else -%}
                    <ul class="cr-main-nav__panel-links">
                      {%- for child in link.links -%}
                        <li{% if forloop.first %} class="cr-main-nav__panel-item--all"{% endif %}>
                          <a href="{{ child.url }}" class="cr-main-nav__panel-link{% if forloop.first %} cr-main-nav__panel-link--all{% endif %}">{{ child.title }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- endif -%}

    </ul>

    <button type="button" class="cr-main-nav__overflow-btn" id="cr-nav-overflow-btn" aria-label="Mais categorias" hidden>
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5h14M3 10h14M3 15h10"/>
      </svg>
      <span>Mais</span>
    </button>

  </div>
</nav>

{% stylesheet %}
  /* ── Nav wrapper ── */
  .cr-main-nav {
    width: 100%;
    background-color: #1A322C;
    position: relative;
    z-index: 100;
  }

  .cr-main-nav__inner {
    width: 100%;
    max-width: var(--page-width, 1620px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
    display: flex;
    align-items: stretch;
  }

  /* ── List ── */
  .cr-main-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: stretch;
    flex-wrap: nowrap;
    overflow: visible;
    flex: 1;
    justify-content: center;
  }

  /* Remove botão "Mais" */
  .cr-main-nav__overflow-btn { display: none !important; }

  /* ── Item ──
     SEM position:relative para que o panel se posicione
     relativo ao .cr-main-nav (full-width) em vez do <li> */
  .cr-main-nav__item {
    display: flex;
    align-items: stretch;
    flex-shrink: 0;
  }

  /* ── Link ── */
  .cr-main-nav__link,
  .cr-main-nav__link span,
  .cr-main-nav__label {
    color: #fff !important;
  }

  .cr-main-nav__link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
    border-radius: 0;
    letter-spacing: 0.02em;
  }

  .cr-main-nav__link:hover,
  .cr-main-nav__link:hover span,
  .cr-main-nav__link:hover .cr-main-nav__label,
  .cr-main-nav__item--has-panel:hover > .cr-main-nav__link,
  .cr-main-nav__item--has-panel:hover > .cr-main-nav__link span {
    background-color: transparent;
    color: #C49A3C !important;
  }

  .cr-main-nav__item--has-panel:hover > .cr-main-nav__link {
    background-color: rgba(255, 255, 255, 0.08);
  }

  /* ── Icon ── */
  .cr-main-nav__icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .cr-main-nav__icon .icon-nav {
    width: 20px;
    height: 20px;
    color: #C49A3C;
    transition: color 0.2s ease;
  }

  .cr-main-nav__link:hover .cr-main-nav__icon .icon-nav,
  .cr-main-nav__item--has-panel:hover .cr-main-nav__icon .icon-nav {
    color: #fff;
  }

  .cr-main-nav__icon-img {
    width: 20px;
    height: 20px;
    display: block;
    flex-shrink: 0;
    background-color: #C49A3C;
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    transition: background-color 0.2s ease;
  }

  .cr-main-nav__link:hover .cr-main-nav__icon-img,
  .cr-main-nav__item--has-panel:hover .cr-main-nav__icon-img {
    background-color: #fff;
  }

  /* ── Chevron ── */
  .cr-main-nav__chevron {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    opacity: 0.6;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .cr-main-nav__item--has-panel:hover > .cr-main-nav__link .cr-main-nav__chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* ── Dropdown panel — full width relativo ao .cr-main-nav ── */
  .cr-main-nav__panel {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #fff;
    border-top: 3px solid #C49A3C;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    pointer-events: none;
  }

  .cr-main-nav__item--has-panel:hover > .cr-main-nav__panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .cr-main-nav__panel-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem var(--page-margin, 20px);
  }

  /* ── Links em 2 colunas ── */
  .cr-main-nav__panel-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.25rem 2rem;
  }

  /* Item "Ver todos" ocupa as 2 colunas e fica separado */
  .cr-main-nav__panel-item--all {
    grid-column: 1 / -1;
    margin-bottom: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid #C49A3C;
  }

  .cr-main-nav__panel-link--all {
    font-size: 18px !important;
    font-weight: 700 !important;
    color: #1A322C !important;
  }

  .cr-main-nav__panel-link--all:hover {
    color: #C49A3C !important;
  }

  .cr-main-nav__panel-link {
    display: block;
    padding: 0.4rem 0;
    color: #1A322C;
    text-decoration: none;
    font-size: 18px;
    font-weight: 700;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .cr-main-nav__panel-link:hover {
    color: #C49A3C;
  }

  /* ── Mega menu (sidebar L2 + painel L3) ── */
  .cr-main-nav__panel--mega .cr-main-nav__panel-inner {
    padding: 0;
    max-height: min(70vh, 520px);
    overflow: hidden;
  }

  .cr-main-nav__mega {
    display: flex;
    align-items: stretch;
    min-height: 220px;
    max-height: inherit;
  }

  .cr-main-nav__mega-sidebar {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0;
    width: min(280px, 32%);
    min-width: 220px;
    flex-shrink: 0;
    border-right: 1px solid #D4C5A9;
    overflow-y: auto;
    max-height: inherit;
    background: #F5F0E8;
  }

  .cr-main-nav__mega-item {
    margin: 0;
  }

  .cr-main-nav__mega-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 1.25rem;
    color: #1A322C;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .cr-main-nav__mega-link:hover,
  .cr-main-nav__mega-item.is-active > .cr-main-nav__mega-link,
  .cr-main-nav__mega-item--has-children:hover > .cr-main-nav__mega-link,
  .cr-main-nav__mega-item--has-children:focus-within > .cr-main-nav__mega-link {
    color: #C49A3C;
    background-color: rgba(196, 154, 60, 0.08);
  }

  .cr-main-nav__mega-item--all {
    margin-bottom: 0.25rem;
    padding-bottom: 0.25rem;
    border-bottom: 2px solid #C49A3C;
  }

  .cr-main-nav__mega-link--all {
    font-size: 16px;
    font-weight: 700;
  }

  .cr-main-nav__mega-arrow {
    width: 6px;
    height: 10px;
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .cr-main-nav__mega-item--has-children:hover > .cr-main-nav__mega-link .cr-main-nav__mega-arrow,
  .cr-main-nav__mega-item.is-active > .cr-main-nav__mega-link .cr-main-nav__mega-arrow {
    opacity: 1;
    transform: translateX(2px);
  }

  .cr-main-nav__mega-content {
    flex: 1;
    position: relative;
    padding: 1.25rem 2rem;
    overflow-y: auto;
    max-height: inherit;
    min-width: 0;
  }

  .cr-main-nav__mega-subpanel {
    width: 100%;
  }

  .cr-main-nav__mega-subpanel[hidden] {
    display: none;
  }

  .cr-main-nav__mega-sublist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cr-nav-columns, 2), minmax(0, 1fr));
    gap: 0.35rem 2rem;
    align-content: start;
  }

  .cr-main-nav__mega-sublink {
    display: block;
    padding: 0.45rem 0;
    color: #1A322C;
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
    transition: color 0.15s ease;
    white-space: normal;
    word-break: break-word;
  }

  .cr-main-nav__mega-sublink:hover {
    color: #C49A3C;
  }

  /* ── Layout em colunas (L2 heading + L3 lista) ── */
  .cr-main-nav__panel-columns {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cr-nav-columns, 2), minmax(0, 1fr));
    gap: 1.5rem 2rem;
    align-items: start;
  }

  .cr-main-nav__panel-column--all {
    grid-column: 1 / -1;
    margin-bottom: 0.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid #C49A3C;
  }

  .cr-main-nav__panel-heading {
    display: block;
    margin-bottom: 0.5rem;
    color: #1A322C;
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    transition: color 0.15s ease;
  }

  .cr-main-nav__panel-heading--all {
    font-size: 18px;
  }

  .cr-main-nav__panel-heading:hover {
    color: #C49A3C;
  }

  .cr-main-nav__panel-sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cr-main-nav__panel-sublink {
    display: block;
    padding: 0.35rem 0;
    color: #1A322C;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .cr-main-nav__panel-sublink:hover {
    color: #C49A3C;
  }

  @media (min-width: 1200px) {
    .cr-main-nav__mega-sidebar {
      width: min(300px, 28%);
    }

    .cr-main-nav__mega-content {
      padding: 1.5rem 2.5rem;
    }
  }

  @media (min-width: 1400px) {
    .cr-main-nav__panel-inner {
      max-width: 1320px;
    }
  }

  /* ── Overflow button ── */
  .cr-main-nav__overflow-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 0.75rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .cr-main-nav__overflow-btn svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .cr-main-nav__overflow-btn:hover {
    color: #C49A3C;
  }

  /* ── Mobile: hide nav, use drawer from header ── */
  @media (max-width: 989px) {
    .cr-main-nav {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var nav         = document.getElementById('cr-main-nav');
    var list        = document.getElementById('cr-main-nav-list');
    var overflowBtn = document.getElementById('cr-nav-overflow-btn');
    if (!nav || !list || !overflowBtn) return;

    var HYSTERESIS = 40;
    var overflowing = false;

    function checkOverflow() {
      if (!overflowing && list.scrollWidth > list.clientWidth + HYSTERESIS) {
        overflowing = true;
        overflowBtn.hidden = false;
      } else if (overflowing && list.scrollWidth <= list.clientWidth - HYSTERESIS) {
        overflowing = false;
        overflowBtn.hidden = true;
      }
    }

    window.addEventListener('resize', checkOverflow);
    checkOverflow();

    /* Mega menu: alterna painel L3 ao hover/focus na sidebar */
    nav.querySelectorAll('.cr-main-nav__mega').forEach(function (mega) {
      var items = mega.querySelectorAll('.cr-main-nav__mega-item--has-children[data-mega-panel]');
      var panels = mega.querySelectorAll('.cr-main-nav__mega-subpanel');
      if (!items.length || !panels.length) return;

      var panelMap = {};
      panels.forEach(function (panel) {
        panelMap[panel.id] = panel;
      });

      function showPanel(panelId, activeItem) {
        panels.forEach(function (panel) {
          if (panel.id === panelId) {
            panel.hidden = false;
          } else {
            panel.hidden = true;
          }
        });
        items.forEach(function (item) {
          item.classList.toggle('is-active', item === activeItem);
        });
      }

      function showDefaultPanel() {
        var firstItem = items[0];
        if (!firstItem) return;
        showPanel(firstItem.getAttribute('data-mega-panel'), firstItem);
      }

      items.forEach(function (item) {
        var panelId = item.getAttribute('data-mega-panel');
        if (!panelId || !panelMap[panelId]) return;

        item.addEventListener('mouseenter', function () {
          showPanel(panelId, item);
        });

        item.addEventListener('focusin', function () {
          showPanel(panelId, item);
        });
      });

      mega.addEventListener('mouseleave', showDefaultPanel);
      showDefaultPanel();
    });

    /* aria-expanded nos itens top-level com dropdown */
    nav.querySelectorAll('.cr-main-nav__item--has-panel').forEach(function (item) {
      var link = item.querySelector(':scope > .cr-main-nav__link');
      if (!link) return;

      item.addEventListener('mouseenter', function () {
        link.setAttribute('aria-expanded', 'true');
      });
      item.addEventListener('mouseleave', function () {
        link.setAttribute('aria-expanded', 'false');
      });
      item.addEventListener('focusin', function () {
        link.setAttribute('aria-expanded', 'true');
      });
      item.addEventListener('focusout', function (e) {
        if (!item.contains(e.relatedTarget)) {
          link.setAttribute('aria-expanded', 'false');
        }
      });
    });
  })();
{% endjavascript %}
